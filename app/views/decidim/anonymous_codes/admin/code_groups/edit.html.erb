<%= decidim_form_for(@form, html: { class: "form-defaults form edit_code_group" }) do |f| %>
  <div class="card">
    <div class="card-divider">
      <h2 class="card-title"><%= t(".title") %>
        <a class="button tiny button--title hollow" href="<%= code_groups_path %>"><%= t("codes.index.back", scope: "decidim.anonymous_codes.admin") %></a>
      </h2>
    </div>

    <div class="card-section">
      <div class="form__wrapper">
        <div class="card-section">
          <%= render partial: "form", object: f %>
        </div>
      </div>
    </div>
  </div>

  <%= f.submit t(".update"), class: "button button__sm button__secondary" %>

<% end %>