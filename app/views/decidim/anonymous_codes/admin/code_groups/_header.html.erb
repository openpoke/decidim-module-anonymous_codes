<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t("code_groups.index.title", scope: "decidim.anonymous_codes.admin") %>
    
    <% if allowed_to?(:create, :anonymous_code_group) and not current_page?(action: 'new') %>
      <div class="flex ml-auto items-center gap-x-4">
        <a class="button button__sm button__secondary new" href="<%= new_code_group_path %>">
          <%= t("code_groups.index.new_access_code_group_button", scope: "decidim.anonymous_codes.admin") %>
        </a>
      </div>
    <% end %>
  </h1>
</div>
