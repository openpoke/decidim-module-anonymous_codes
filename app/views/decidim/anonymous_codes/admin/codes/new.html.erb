<div class="item_show__header">
  <h2 class="item_show__header-title">
    <%= t(".title", group: translated_attribute(code_group.title)) %>
    <%= link_to t("codes.index.back_to_codes", scope: "decidim.anonymous_codes.admin"), code_group_codes_path(code_group), class: "button button__sm button__transparent-secondary" %>
  </h2>
</div>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <%= decidim_form_for(@form, url: code_group_codes_path, html: { class: "form new_code_group_code" }) do |f| %>
      <%= render partial: "form", object: f %>
      <div class="item__edit-sticky">
        <div class="item__edit-sticky-container">
          <%= f.submit t(".button_create_tokens"), class: "button button__sm button__secondary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
