<div class="card">

  <% add_decidim_page_title(t(".title")) %>

  <%= render partial: "header" %>

 <div class="card-section">
     <div class="table-scroll">
        <table class="table-list">
          <thead>
            <tr>
              <th><%= sort_link(query, :token, t(".token")) %></th>
              <th><%= sort_link(query, :available, t(".available")) %></th>
              <th><%= sort_link(query, :used, t(".used")) %></th>
              <th><%= sort_link(query, :usage_count, t(".usage_count")) %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @tokens.each do |token| %>
              <% serialized = Decidim::AnonymousCodes::TokenSerializer.new(token).serialize %>
              <tr>
                <td><%= token.token %></td>
                <td><%= t("booleans.#{token.available?}") %></td>
                <td><%= t("booleans.#{token.used?}") %></td>
                <td><%= token.usage_count %></td>
                <td class="table-list__actions">
                  <%= icon_link_to "eye-line", serialized[:resource_url], t("actions.preview", scope: "decidim.anonymous_codes.admin"), class: "#{serialized[:resource_url].present? ? '' : ' invisible'}", target: :blank, data: { "external-link": false } %>
                  <%= icon_link_to "close-circle-line", code_group_code_path(code_group, token), t("actions.destroy", scope: "decidim.anonymous_codes.admin"), method: :delete, class: "action-icon--remove#{allowed_to?(:destroy, :anonymous_code_token, token: token) ? '' : ' invisible'}", data: { confirm: t("actions.confirm_destroy_code", scope: "decidim.anonymous_codes.admin") } %>
                </td>
              </tr>
              <% end %>
          </tbody>
        </table>
        <%= paginate @tokens, theme: "decidim" %>
      </div>
  </div>
</div>
