<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t("codes.index.title", scope: "decidim.anonymous_codes.admin", group: translated_attribute(code_group.title)) %>
  </h1>

  <div class="flex w-full items-center gap-x-4">
    <%= link_to t("codes.index.back", scope: "decidim.anonymous_codes.admin"), code_groups_path, class: "button button__sm button__transparent-secondary" %>
    <div id="js-other-actions-wrapper">
      <%= render "export_dropdown" %>
    </div>

    <% if allowed_to?(:create, :anonymous_code_token) %>
      <%= link_to bulk_code_group_codes_path(code_group), class: "button button__sm button__secondary new" do %>
        <%= t("codes.index.bulk_codes_button", scope: "decidim.anonymous_codes.admin") %>
      <% end %>

      <%= link_to new_code_group_code_path(code_group), class: "button button__sm button__secondary" do %>
        <%= t("codes.index.new_codes_button", scope: "decidim.anonymous_codes.admin") %>
      <% end %>
    <% end %>
  </div>
</div>
